---
import TerminalPlaceholder from './TerminalPlaceholder.astro'

interface Props {
  headline: string
  subheadline: string
  badge?: string
  ctaPrimary?: {label: string; href: string}
  ctaSecondary?: {label: string; href: string}
  terminalDemo?: {title: string; darkSrc: string; lightSrc: string; alt?: string}
}

const {headline, subheadline, badge, ctaPrimary, ctaSecondary, terminalDemo} = Astro.props
const split = Boolean(terminalDemo)
---

<section class="relative isolate overflow-hidden px-6">
  <div aria-hidden="true" class="hero-backdrop absolute inset-0 -z-10"></div>
  <div
    class:list={[
      'mx-auto grid w-full gap-12 py-16 md:py-24',
      split
        ? 'max-w-7xl lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-16'
        : 'max-w-4xl justify-items-center text-center',
    ]}
  >
    <div class={split ? 'max-w-2xl' : 'max-w-3xl'}>
      {
        badge && (
          <span class="mb-5 inline-flex items-center rounded-full border border-molten-200 bg-molten-50 px-3 py-1 font-mono text-xs font-semibold tracking-wide text-molten-700 uppercase dark:border-molten-800 dark:bg-molten-900/25 dark:text-molten-300">
            {badge}
          </span>
        )
      }
      <h1
        class:list={[
          'text-4xl leading-[1.04] font-semibold tracking-[-0.05em] text-balance text-steel-950 sm:text-5xl dark:text-steel-50',
          split ? 'lg:text-6xl' : 'md:text-6xl lg:text-7xl',
        ]}
      >
        {headline}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-steel-600 md:text-lg dark:text-steel-300">
        {subheadline}
      </p>

      {
        (ctaPrimary || ctaSecondary) && (
          <div class:list={['mt-8 flex flex-wrap items-center gap-3', !split && 'justify-center']}>
            {ctaPrimary && (
              <a href={ctaPrimary.href} class="button-primary">
                {ctaPrimary.label}
              </a>
            )}
            {ctaSecondary && (
              <a href={ctaSecondary.href} class="button-secondary">
                {ctaSecondary.label}
              </a>
            )}
          </div>
        )
      }
    </div>

    {
      terminalDemo && (
        <div class="w-full min-w-0 lg:pl-4">
          <TerminalPlaceholder
            title={terminalDemo.title}
            darkSrc={terminalDemo.darkSrc}
            lightSrc={terminalDemo.lightSrc}
            alt={terminalDemo.alt}
          />
        </div>
      )
    }
  </div>
</section>
