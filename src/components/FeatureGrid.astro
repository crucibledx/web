---
interface Feature {
  title: string
  description: string
  icon?: string
}

interface Props {
  features: Feature[]
  columns?: 2 | 3 | 4
}

const {features, columns = 3} = Astro.props

const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
}
---

<div
  class={`grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-steel-200 bg-steel-200 dark:border-steel-800 dark:bg-steel-800 ${gridCols[columns]}`}
>
  {
    features.map((feature) => (
      <div class="bg-white p-6 transition-colors hover:bg-steel-50 md:p-7 dark:bg-steel-900 dark:hover:bg-steel-900/70">
        {feature.icon && (
          <span class="mb-5 flex h-9 w-9 items-center justify-center rounded-lg border border-steel-200 bg-steel-50 text-lg dark:border-steel-700 dark:bg-steel-950">
            {feature.icon}
          </span>
        )}
        <h3 class="text-base font-semibold tracking-tight text-steel-950 dark:text-steel-50">{feature.title}</h3>
        <p class="mt-2 text-sm leading-6 text-steel-600 dark:text-steel-300" set:html={feature.description} />
      </div>
    ))
  }
</div>
