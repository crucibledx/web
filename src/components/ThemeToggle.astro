---

---

<starlight-theme-toggle>
  <button type="button" aria-label="Toggle dark mode" class="sl-flex">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon-sun"
    >
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon-moon"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </button>
</starlight-theme-toggle>

<style>
  starlight-theme-toggle button {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.375rem;
    border-radius: 0.5rem;
    color: var(--sl-color-gray-3);
    transition: color 0.2s;
  }
  starlight-theme-toggle button:hover {
    color: var(--sl-color-white);
  }
  :root[data-theme='light'] .icon-moon {
    display: none;
  }
  :root[data-theme='dark'] .icon-sun {
    display: none;
  }
  :root:not([data-theme='dark']) .icon-moon {
    display: none;
  }
</style>

<script>
  const storageKey = 'starlight-theme'

  const getPreferredColorScheme = (): 'light' | 'dark' =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'

  const getTheme = (): 'light' | 'dark' => {
    const stored = typeof localStorage !== 'undefined' && localStorage.getItem(storageKey)
    if (stored === 'light' || stored === 'dark') return stored
    return getPreferredColorScheme()
  }

  function setTheme(theme: 'light' | 'dark'): void {
    document.documentElement.dataset.theme = theme
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme)
    }
    // Update Starlight's pickers if they exist
    if (typeof (globalThis as any).StarlightThemeProvider !== 'undefined') {
      ;(globalThis as any).StarlightThemeProvider.updatePickers(theme)
    }
  }

  class StarlightThemeToggle extends HTMLElement {
    constructor() {
      super()
      this.querySelector('button')?.addEventListener('click', () => {
        const current = getTheme()
        setTheme(current === 'dark' ? 'light' : 'dark')
      })
    }
  }
  customElements.define('starlight-theme-toggle', StarlightThemeToggle)
</script>
