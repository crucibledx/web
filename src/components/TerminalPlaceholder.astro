---
interface Props {
  title?: string
}

const {title = 'Terminal demo'} = Astro.props
---

<div class="mx-auto max-w-2xl overflow-hidden rounded-lg border border-steel-200 shadow-lg dark:border-steel-700">
  <div
    class="flex items-center gap-2 border-b border-steel-200 bg-steel-100 px-4 py-2.5 dark:border-steel-700 dark:bg-steel-800"
  >
    <div class="flex gap-1.5">
      <span class="h-3 w-3 rounded-full bg-red-400"></span>
      <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
      <span class="h-3 w-3 rounded-full bg-green-400"></span>
    </div>
    <span class="ml-2 text-xs font-medium text-steel-400 dark:text-steel-500">{title}</span>
  </div>
  <div class="flex min-h-[200px] items-center justify-center bg-steel-900 p-8 dark:bg-steel-950">
    <p class="font-mono text-sm text-steel-400">Terminal demo coming soon</p>
  </div>
</div>
