---
import {Icon} from 'astro-icon/components'

interface Props {
  name: string
  description: string
  href?: string
  badge?: string
  icon?: string
  iconName?: string
  iconClass?: string
  learnMore?: string
}

const {name, description, href, badge, icon, iconName, iconClass, learnMore = 'Learn more'} = Astro.props
---

<div
  class="group relative rounded-xl border border-steel-200 bg-white p-6 transition-all hover:border-molten-400 hover:shadow-md dark:border-steel-700 dark:bg-steel-800 dark:hover:border-molten-500"
>
  {
    badge && (
      <span class="absolute top-4 right-4 rounded-full bg-molten-100 px-2.5 py-0.5 text-xs font-medium text-molten-700 dark:bg-molten-900/30 dark:text-molten-400">
        {badge}
      </span>
    )
  }

  <div class="mb-3">
    {iconName && <Icon name={iconName} class:list={['h-8 w-8', iconClass]} />}
    {!iconName && icon && <span class="inline-block h-8 w-8" set:html={icon} />}
  </div>

  <h3 class="mb-2 text-lg font-bold text-steel-900 dark:text-steel-100">{name}</h3>
  <p class="mb-4 text-sm text-steel-500 dark:text-steel-400">{description}</p>

  {
    href && (
      <a
        href={href}
        class="inline-flex items-center text-sm font-medium text-molten-500 transition-colors hover:text-molten-700 dark:text-molten-400 dark:hover:text-molten-200"
      >
        {learnMore}
        <svg
          class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
            clip-rule="evenodd"
          />
        </svg>
      </a>
    )
  }
</div>
