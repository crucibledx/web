---
import {Icon} from 'astro-icon/components'

interface Props {
  name: string
  description: string
  href?: string
  badge?: string
  icon?: string
  iconName?: string
  iconClass?: string
  learnMore?: string
}

const {name, description, href, badge, icon, iconName, iconClass, learnMore = 'Learn more'} = Astro.props
---

<div
  class="group marketing-panel relative flex min-h-72 flex-col p-6 transition duration-200 hover:-translate-y-0.5 hover:border-molten-300 hover:shadow-[0_16px_40px_rgb(13_17_23/0.08)] md:p-7 dark:hover:border-molten-700"
>
  <div class="mb-6 flex items-start justify-between gap-4">
    <div
      class="flex h-11 w-11 items-center justify-center rounded-xl border border-steel-200 bg-steel-50 dark:border-steel-700 dark:bg-steel-950"
    >
      {iconName && <Icon name={iconName} class:list={['h-6 w-6', iconClass]} />}
      {!iconName && icon && <span class="inline-block h-6 w-6" set:html={icon} />}
    </div>
    {
      badge && (
        <span class="rounded-full border border-steel-200 bg-steel-50 px-2.5 py-1 font-mono text-[11px] font-medium text-steel-600 dark:border-steel-700 dark:bg-steel-950 dark:text-steel-300">
          {badge}
        </span>
      )
    }
  </div>

  <h3 class="text-xl font-semibold tracking-tight text-steel-950 dark:text-steel-50">{name}</h3>
  <p class="mt-3 flex-1 text-sm leading-6 text-steel-600 dark:text-steel-300">{description}</p>

  {
    href && (
      <a
        href={href}
        class="mt-6 inline-flex items-center text-sm font-semibold text-molten-600 transition-colors hover:text-molten-700 dark:text-molten-400 dark:hover:text-molten-300"
      >
        {learnMore}
        <svg
          class="ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-1"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
            clip-rule="evenodd"
          />
        </svg>
      </a>
    )
  }
</div>
