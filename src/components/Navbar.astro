---
import logoDark from '../assets/logo-dark.svg'
import logoLight from '../assets/logo-light.svg'
import {defaultLocale, useTranslations} from '../i18n'
import type {Locale} from '../i18n'

interface Props {
  locale?: Locale
}

const {locale = defaultLocale} = Astro.props
const t = useTranslations(locale, 'common')
const prefix = locale === defaultLocale ? '' : `/${locale}`

const navLinks = [
  {label: t('nav.forge'), href: `${prefix}/forge`},
  {label: t('nav.skills'), href: `${prefix}/starter`},
  {label: t('nav.ember'), href: `${prefix}/ember`},
  {label: t('nav.about'), href: `${prefix}/about`},
  {label: t('nav.docs'), href: '/getting-started/installation'},
]
---

<header
  class="sticky top-0 z-50 border-b border-steel-200 bg-white/90 backdrop-blur dark:border-steel-800 dark:bg-steel-950/90"
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a
      href={`${prefix}/`}
      class="flex items-center gap-2 text-lg font-bold tracking-tight text-steel-900 dark:text-steel-100"
    >
      <img src={logoLight.src} alt="Crucible" width="28" height="28" class="shrink-0 rounded-full dark:hidden" />
      <img src={logoDark.src} alt="Crucible" width="28" height="28" class="hidden shrink-0 rounded-full dark:block" />
      Crucible
    </a>

    <ul class="hidden items-center gap-6 md:flex">
      {
        navLinks.map(({label, href}) => (
          <li>
            <a
              href={href}
              class="text-sm font-medium text-steel-500 transition-colors hover:text-molten-500 dark:text-steel-300 dark:hover:text-molten-400"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <!-- GitHub -->
      <a
        href="https://github.com/crucibledx"
        target="_blank"
        rel="noopener noreferrer"
        class="text-steel-400 transition-colors hover:text-steel-900 dark:hover:text-steel-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
      </a>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label={t('nav.toggleDarkMode')}
        class="rounded-lg p-2 text-steel-400 transition-colors hover:bg-steel-100 hover:text-steel-900 dark:hover:bg-steel-800 dark:hover:text-steel-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="block dark:hidden"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden dark:block"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label={t('nav.toggleMenu')}
        class="rounded-lg p-2 text-steel-400 transition-colors hover:bg-steel-100 hover:text-steel-900 dark:hover:bg-steel-800 dark:hover:text-steel-100 md:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line
            x1="3"
            y1="18"
            x2="21"
            y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-steel-200 bg-white px-6 py-4 dark:border-steel-800 dark:bg-steel-950 md:hidden"
  >
    <ul class="flex flex-col gap-3">
      {
        navLinks.map(({label, href}) => (
          <li>
            <a
              href={href}
              class="block text-sm font-medium text-steel-500 transition-colors hover:text-molten-500 dark:text-steel-300 dark:hover:text-molten-400"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Theme toggle — uses 'starlight-theme' key shared with Starlight docs
  const toggle = document.getElementById('theme-toggle')
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark')
    localStorage.setItem('starlight-theme', isDark ? 'dark' : 'light')
  })

  // Mobile menu toggle
  const menuToggle = document.getElementById('mobile-menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu')
  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden')
  })
</script>
