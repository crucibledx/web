---
import MarketingLayout from '../../layouts/MarketingLayout.astro'
import Hero from '../../components/Hero.astro'
import TerminalPlaceholder from '../../components/TerminalPlaceholder.astro'
import FeatureGrid from '../../components/FeatureGrid.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import {getLocalePaths, getMessages, useTranslations} from '../../i18n'
import {demos} from '../../lib/assets'
import type {LocaleProps} from '../../i18n'

export const getStaticPaths = getLocalePaths

const {locale} = Astro.props as LocaleProps
const t = useTranslations(locale, 'forge')
const messages = getMessages(locale, 'forge')

const commandItems = messages.commands.items as Array<{cmd: string; desc: string}>
const assistantItems = messages.assistants.items as Array<{name: string; paths: string; transform: string}>
const demoItems = messages.demos.items as Array<{title: string; description: string}>

const demoGifs = [
  {dark: demos.forge.setAndForget('dark'), light: demos.forge.setAndForget('light')},
  {dark: demos.forge.easyUpdates('dark'), light: demos.forge.easyUpdates('light')},
  {dark: demos.forge.powerUser('dark'), light: demos.forge.powerUser('light')},
]
---

<MarketingLayout title={t('meta.title')} description={t('meta.description')} locale={locale}>
  <Hero
    headline={t('hero.headline')}
    subheadline={t('hero.subheadline')}
    ctaPrimary={{label: t('hero.ctaPrimary'), href: '/getting-started/installation'}}
    ctaSecondary={{label: t('hero.ctaSecondary'), href: '/forge/commands'}}
    terminalDemo={{
      title: t('hero.terminalDemo'),
      darkSrc: demos.forge.setAndForget('dark'),
      lightSrc: demos.forge.setAndForget('light'),
      alt: 'Forge CLI — init and sync demo',
    }}
  />

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('setup.heading')} />
      <div class="mt-10 grid grid-cols-1 gap-5 lg:grid-cols-2">
        <div class="marketing-panel p-6 md:p-7">
          <h3 class="text-lg font-semibold tracking-tight text-molten-600 dark:text-molten-400">
            {t('setup.global.title')}
          </h3>
          <p
            class="mt-3 text-sm leading-6 text-steel-600 dark:text-steel-300"
            set:html={t('setup.global.description')}
          />
          <div class="code-panel mt-6">
            <span class="text-steel-400">$</span> brew install crucibledx/tap/forge<br />
            <span class="text-steel-400">$</span> forge init --global<br />
            <span class="text-molten-400">✓</span> Global config created.
          </div>
        </div>
        <div class="marketing-panel p-6 md:p-7">
          <h3 class="text-lg font-semibold tracking-tight text-molten-600 dark:text-molten-400">
            {t('setup.project.title')}
          </h3>
          <p
            class="mt-3 text-sm leading-6 text-steel-600 dark:text-steel-300"
            set:html={t('setup.project.description')}
          />
          <div class="code-panel mt-6">
            <span class="text-steel-400">$</span> cd my-project<br />
            <span class="text-steel-400">$</span> forge init<br />
            <span class="text-molten-400">✓</span> Project-level config created.
          </div>
        </div>
      </div>
      <p class="mt-6 text-sm leading-6 text-steel-500 dark:text-steel-400">
        {t('setup.footer')}
      </p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <div class="marketing-panel p-6 md:p-10">
        <SectionHeading heading={t('source.heading')} />
        <p class="mt-4 max-w-3xl text-base leading-7 text-steel-600 dark:text-steel-300">
          {t('source.description').split('{link}')[0]}<a
            href="/starter"
            class="font-medium text-molten-600 hover:text-molten-700 dark:text-molten-400">{t('source.platformLink')}</a
          >{t('source.description').split('{link}')[1]}
        </p>
        <div
          class="mt-6 inline-flex items-start gap-2 rounded-lg border border-molten-200 bg-molten-50 px-4 py-3 text-sm leading-6 text-molten-700 dark:border-molten-800 dark:bg-molten-950/30 dark:text-molten-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mt-1 shrink-0"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg
          >
          {t('source.note')}
        </div>
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('demos.heading')} />
      <div class="mt-12 space-y-16">
        {
          demoItems.map((item, i) => (
            <div class="grid items-center gap-6 lg:grid-cols-3 lg:gap-10">
              <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
                <span class="font-mono text-xs font-semibold tracking-[0.16em] text-molten-600 dark:text-molten-400">
                  0{i + 1}
                </span>
                <h3 class="mt-3 text-xl font-semibold tracking-tight text-steel-950 dark:text-steel-50">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-6 text-steel-600 dark:text-steel-300">{item.description}</p>
              </div>
              <div class={`min-w-0 lg:col-span-2 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
                <TerminalPlaceholder
                  title={item.title}
                  darkSrc={demoGifs[i].dark}
                  lightSrc={demoGifs[i].light}
                  alt={`Forge CLI demo — ${item.title}`}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('commands.heading')} />
      <div class="marketing-table-wrap" tabindex="0" role="region" aria-label={t('commands.heading')}>
        <table class="marketing-table">
          <thead>
            <tr>
              <th>{t('commands.thCommand')}</th>
              <th>{t('commands.thDescription')}</th>
            </tr>
          </thead>
          <tbody>
            {
              commandItems.map((item) => (
                <tr>
                  <td class="font-mono text-xs font-medium whitespace-nowrap text-molten-600 dark:text-molten-400">
                    {item.cmd}
                  </td>
                  <td>{item.desc}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('assistants.heading')} />
      <div class="marketing-table-wrap" tabindex="0" role="region" aria-label={t('assistants.heading')}>
        <table class="marketing-table min-w-[56rem]">
          <thead>
            <tr>
              <th>{t('assistants.thAssistant')}</th>
              <th>{t('assistants.thPaths')}</th>
              <th>{t('assistants.thTransforms')}</th>
            </tr>
          </thead>
          <tbody>
            {
              assistantItems.map((item) => (
                <tr>
                  <td class="font-semibold whitespace-nowrap text-steel-950 dark:text-steel-50">{item.name}</td>
                  <td class="font-mono text-xs">{item.paths}</td>
                  <td>{item.transform}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm leading-6 text-steel-500 dark:text-steel-400">
        {t('assistants.footer')}
        <a href="/forge/assistants" class="ml-1 font-medium text-molten-600 hover:text-molten-700 dark:text-molten-400"
          >{t('assistants.learnMore')}</a
        >
      </p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('features.heading')} />
      <div class="mt-10">
        <FeatureGrid
          columns={4}
          features={messages.features.items as Array<{icon: string; title: string; description: string}>}
        />
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('layouts.heading')} />
      <div class="mt-10">
        <FeatureGrid
          columns={3}
          features={[
            {title: t('layouts.canonical.title'), description: t('layouts.canonical.description')},
            {title: t('layouts.preStructured.title'), description: t('layouts.preStructured.description')},
            {title: t('layouts.hybrid.title'), description: t('layouts.hybrid.description')},
          ]}
        />
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('compiler.heading')} description={t('compiler.description')} />
      <div class="mt-10">
        <FeatureGrid
          columns={3}
          features={messages.compiler.items as Array<{icon: string; title: string; description: string}>}
        />
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <div class="rounded-3xl border border-steel-800 bg-steel-950 p-8 md:p-12">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-semibold tracking-[-0.035em] text-steel-50 md:text-4xl">{t('cta.heading')}</h2>
          <p class="mt-4 text-base leading-7 text-steel-300" set:html={t('cta.description')} />
          <a href="/getting-started/quick-start" class="button-primary mt-8">
            {t('cta.button')}
          </a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
