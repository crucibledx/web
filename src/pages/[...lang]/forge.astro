---
import MarketingLayout from '../../layouts/MarketingLayout.astro'
import Hero from '../../components/Hero.astro'
import TerminalPlaceholder from '../../components/TerminalPlaceholder.astro'
import FeatureGrid from '../../components/FeatureGrid.astro'
import {getLocalePaths, getMessages, useTranslations} from '../../i18n'
import {demos} from '../../lib/assets'
import type {LocaleProps} from '../../i18n'

export const getStaticPaths = getLocalePaths

const {locale} = Astro.props as LocaleProps
const t = useTranslations(locale, 'forge')
const messages = getMessages(locale, 'forge')

const commandItems = messages.commands.items as Array<{cmd: string; desc: string}>
const assistantItems = messages.assistants.items as Array<{name: string; paths: string; transform: string}>
const demoItems = messages.demos.items as Array<{title: string; description: string}>

const demoGifs = [
  {dark: demos.forge.setAndForget('dark'), light: demos.forge.setAndForget('light')},
  {dark: demos.forge.easyUpdates('dark'), light: demos.forge.easyUpdates('light')},
  {dark: demos.forge.powerUser('dark'), light: demos.forge.powerUser('light')},
]
---

<MarketingLayout title={t('meta.title')} description={t('meta.description')} locale={locale}>
  <Hero
    headline={t('hero.headline')}
    subheadline={t('hero.subheadline')}
    ctaPrimary={{label: t('hero.ctaPrimary'), href: '/getting-started/installation'}}
    ctaSecondary={{label: t('hero.ctaSecondary'), href: '/forge/commands'}}
    terminalDemo={{
      title: t('hero.terminalDemo'),
      darkSrc: demos.forge.setAndForget('dark'),
      lightSrc: demos.forge.setAndForget('light'),
      alt: 'Forge CLI — init and sync demo',
    }}
  />

  <!-- How it works — the "configure once" story -->
  <section class="border-t border-steel-200 bg-steel-50 px-6 py-16 dark:border-steel-800 dark:bg-steel-900">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-10 text-center text-2xl font-bold text-steel-900 dark:text-steel-100">
        {t('setup.heading')}
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-steel-200 bg-white p-6 dark:border-steel-700 dark:bg-steel-800">
          <h3 class="mb-2 font-bold text-molten-500 dark:text-molten-400">{t('setup.global.title')}</h3>
          <p class="mb-3 text-sm text-steel-500 dark:text-steel-400" set:html={t('setup.global.description')} />
          <div class="rounded-md bg-steel-900 px-4 py-2 font-mono text-xs text-steel-100 dark:bg-steel-950">
            <span class="text-steel-400">$</span> bun add -g @crucibledx/forge-cli<br />
            <span class="text-steel-400">$</span> forge init --global<br />
            <span class="text-molten-400">✓</span> Done. Forge will sync automatically.
          </div>
        </div>
        <div class="rounded-lg border border-steel-200 bg-white p-6 dark:border-steel-700 dark:bg-steel-800">
          <h3 class="mb-2 font-bold text-molten-500 dark:text-molten-400">{t('setup.project.title')}</h3>
          <p class="mb-3 text-sm text-steel-500 dark:text-steel-400" set:html={t('setup.project.description')} />
          <div class="rounded-md bg-steel-900 px-4 py-2 font-mono text-xs text-steel-100 dark:bg-steel-950">
            <span class="text-steel-400">$</span> cd my-project<br />
            <span class="text-steel-400">$</span> forge init<br />
            <span class="text-molten-400">✓</span> Project-level config created.
          </div>
        </div>
      </div>
      <p class="mt-6 text-center text-sm text-steel-400 dark:text-steel-500">
        {t('setup.footer')}
      </p>
    </div>
  </section>

  <!-- Recommended source -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="mb-4 text-2xl font-bold text-steel-900 dark:text-steel-100">
        {t('source.heading')}
      </h2>
      <p class="mx-auto mb-8 max-w-2xl text-steel-500 dark:text-steel-400">
        {t('source.description').split('{link}')[0]}<a
          href="/starter"
          class="text-molten-500 hover:text-molten-700 dark:text-molten-400">{t('source.platformLink')}</a
        >{t('source.description').split('{link}')[1]}
      </p>
      <div
        class="inline-flex items-center gap-2 rounded-lg border border-molten-200 bg-molten-100/50 px-4 py-2 text-sm text-molten-700 dark:border-molten-900/50 dark:bg-molten-900/20 dark:text-molten-400"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg
        >
        {t('source.note')}
      </div>
    </div>
  </section>

  <!-- Demos -->
  <section class="border-t border-steel-200 bg-steel-50 px-6 py-16 dark:border-steel-800 dark:bg-steel-900">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-12 text-center text-2xl font-bold text-steel-900 dark:text-steel-100">
        {t('demos.heading')}
      </h2>
      <div class="space-y-16">
        {
          demoItems.map((item, i) => (
            <div class={`flex flex-col gap-6 ${i % 2 === 1 ? 'md:flex-row-reverse' : 'md:flex-row'} items-center`}>
              <div class="flex-1">
                <h3 class="mb-2 text-lg font-bold text-steel-900 dark:text-steel-100">{item.title}</h3>
                <p class="text-sm text-steel-500 dark:text-steel-400">{item.description}</p>
              </div>
              <div class="w-full flex-[2]">
                <TerminalPlaceholder
                  title={item.title}
                  darkSrc={demoGifs[i].dark}
                  lightSrc={demoGifs[i].light}
                  alt={`Forge CLI demo — ${item.title}`}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Commands -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-7xl">
      <h2 class="mb-10 text-center text-2xl font-bold text-steel-900 dark:text-steel-100">
        {t('commands.heading')}
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-steel-200 dark:border-steel-700">
              <th class="py-3 pr-4 font-semibold text-steel-900 dark:text-steel-100">{t('commands.thCommand')}</th>
              <th class="py-3 font-semibold text-steel-900 dark:text-steel-100">{t('commands.thDescription')}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-steel-100 dark:divide-steel-800">
            {
              commandItems.map((item) => (
                <tr>
                  <td class="py-2.5 pr-4 font-mono text-molten-500 dark:text-molten-400">{item.cmd}</td>
                  <td class="py-2.5 text-steel-500 dark:text-steel-400">{item.desc}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Assistants -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-7xl">
      <h2 class="mb-10 text-center text-2xl font-bold text-steel-900 dark:text-steel-100">{t('assistants.heading')}</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-steel-200 dark:border-steel-700">
              <th class="py-3 pr-4 font-semibold text-steel-900 dark:text-steel-100">{t('assistants.thAssistant')}</th>
              <th class="py-3 pr-4 font-semibold text-steel-900 dark:text-steel-100">{t('assistants.thPaths')}</th>
              <th class="py-3 font-semibold text-steel-900 dark:text-steel-100">{t('assistants.thTransforms')}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-steel-100 dark:divide-steel-800">
            {
              assistantItems.map((item) => (
                <tr>
                  <td class="py-2.5 pr-4 font-semibold text-steel-900 dark:text-steel-100">{item.name}</td>
                  <td class="py-2.5 pr-4 font-mono text-xs text-steel-500 dark:text-steel-400">{item.paths}</td>
                  <td class="py-2.5 text-steel-500 dark:text-steel-400">{item.transform}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-center text-sm text-steel-400 dark:text-steel-500">
        {t('assistants.footer')}
        <a href="/forge/assistants" class="text-molten-500 hover:text-molten-700 dark:text-molten-400"
          >{t('assistants.learnMore')}</a
        >
      </p>
    </div>
  </section>

  <!-- Sync Engine Features -->
  <section class="border-t border-steel-200 bg-steel-50 px-6 py-16 dark:border-steel-800 dark:bg-steel-900">
    <div class="mx-auto max-w-7xl">
      <h2 class="mb-10 text-center text-2xl font-bold text-steel-900 dark:text-steel-100">{t('features.heading')}</h2>
      <FeatureGrid
        columns={4}
        features={messages.features.items as Array<{icon: string; title: string; description: string}>}
      />
    </div>
  </section>

  <!-- Layouts -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-10 text-center text-2xl font-bold text-steel-900 dark:text-steel-100">
        {t('layouts.heading')}
      </h2>
      <div class="space-y-6">
        <div class="rounded-lg border border-steel-200 bg-white p-5 dark:border-steel-700 dark:bg-steel-800">
          <h3 class="mb-1 font-bold text-steel-900 dark:text-steel-100">{t('layouts.canonical.title')}</h3>
          <p class="text-sm text-steel-500 dark:text-steel-400" set:html={t('layouts.canonical.description')} />
        </div>
        <div class="rounded-lg border border-steel-200 bg-white p-5 dark:border-steel-700 dark:bg-steel-800">
          <h3 class="mb-1 font-bold text-steel-900 dark:text-steel-100">{t('layouts.preStructured.title')}</h3>
          <p class="text-sm text-steel-500 dark:text-steel-400" set:html={t('layouts.preStructured.description')} />
        </div>
        <div class="rounded-lg border border-steel-200 bg-white p-5 dark:border-steel-700 dark:bg-steel-800">
          <h3 class="mb-1 font-bold text-steel-900 dark:text-steel-100">{t('layouts.hybrid.title')}</h3>
          <p class="text-sm text-steel-500 dark:text-steel-400" set:html={t('layouts.hybrid.description')} />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 py-16 text-center">
    <div class="mx-auto max-w-2xl">
      <h2 class="mb-4 text-2xl font-bold text-steel-900 dark:text-steel-100">{t('cta.heading')}</h2>
      <p class="mb-8 text-steel-500 dark:text-steel-400" set:html={t('cta.description')} />
      <a
        href="/getting-started/quick-start"
        class="inline-block rounded-lg bg-molten-500 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-molten-700"
      >
        {t('cta.button')}
      </a>
    </div>
  </section>
</MarketingLayout>
