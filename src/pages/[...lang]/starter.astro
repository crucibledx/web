---
import MarketingLayout from '../../layouts/MarketingLayout.astro'
import Hero from '../../components/Hero.astro'
import FeatureGrid from '../../components/FeatureGrid.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import {getLocalePaths, getMessages, useTranslations} from '../../i18n'
import {diagrams} from '../../lib/assets'
import type {LocaleProps} from '../../i18n'

export const getStaticPaths = getLocalePaths

const {locale} = Astro.props as LocaleProps
const t = useTranslations(locale, 'starter')
const messages = getMessages(locale, 'starter')

const conventionItems = messages.conventions.items as Array<{
  what: string
  convention: string
  discovery: string
}>
const skillItems = messages.catalog.skills as Array<{
  name: string
  version: string
  type: string
  description: string
}>
const ruleItems = messages.catalog.rules as Array<{name: string; description: string}>
const specimenItems = messages.testing.specimens as Array<{code: string; description: string}>
const monorepoTeams = messages.monorepo.teams as Array<{name: string; description: string}>
---

<MarketingLayout title={t('meta.title')} description={t('meta.description')} locale={locale}>
  <Hero
    headline={t('hero.headline')}
    subheadline={`${t('hero.subheadline')} ${t('hero.subheadline2')}`}
    ctaPrimary={{label: t('hero.ctaPrimary'), href: 'https://github.com/crucibledx/forge-skills-starter'}}
    ctaSecondary={{label: t('hero.ctaSecondary'), href: '/starter/overview'}}
  />

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('conventions.heading')} description={t('conventions.description')} />
      <div class="marketing-table-wrap" tabindex="0" role="region" aria-label={t('conventions.heading')}>
        <table class="marketing-table min-w-[48rem]">
          <thead>
            <tr>
              <th>{t('conventions.thWhat')}</th>
              <th>{t('conventions.thConvention')}</th>
              <th>{t('conventions.thDiscovery')}</th>
            </tr>
          </thead>
          <tbody>
            {
              conventionItems.map((item) => (
                <tr>
                  <td class="font-semibold text-steel-950 dark:text-steel-50">{item.what}</td>
                  <td class="font-mono text-xs">{item.convention}</td>
                  <td>{item.discovery}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('lifecycle.heading')} description={t('lifecycle.description')} />
      <div class="marketing-panel mt-10 overflow-x-auto p-4 md:p-8">
        <img
          src={diagrams.platformFlow}
          alt={t('lifecycle.diagramAlt')}
          class="mx-auto max-w-full dark:invert dark:hue-rotate-180"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('orchestrator.heading')} />
      <div class="mt-10">
        <FeatureGrid
          columns={3}
          features={[
            {
              icon: t('orchestrator.design.icon'),
              title: t('orchestrator.design.title'),
              description: t('orchestrator.design.description'),
            },
            {
              icon: t('orchestrator.develop.icon'),
              title: t('orchestrator.develop.title'),
              description: t('orchestrator.develop.description'),
            },
            {
              icon: t('orchestrator.test.icon'),
              title: t('orchestrator.test.title'),
              description: t('orchestrator.test.description'),
            },
          ]}
        />
      </div>
      <p class="mt-6 text-sm leading-6 text-steel-500 dark:text-steel-400" set:html={t('orchestrator.footer')} />
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('catalog.heading')} />

      <h3 class="mt-10 font-mono text-xs font-semibold tracking-[0.14em] text-steel-500 uppercase dark:text-steel-400">
        {t('catalog.skillsHeading')}
      </h3>
      <div class="marketing-table-wrap mt-4" tabindex="0" role="region" aria-label={t('catalog.heading')}>
        <table class="marketing-table min-w-[48rem]">
          <thead>
            <tr>
              <th>{t('catalog.thSkill')}</th>
              <th>{t('catalog.thVersion')}</th>
              <th>{t('catalog.thType')}</th>
              <th>{t('catalog.thDescription')}</th>
            </tr>
          </thead>
          <tbody>
            {
              skillItems.map((item) => (
                <tr>
                  <td class="font-mono text-xs font-medium text-molten-600 dark:text-molten-400">{item.name}</td>
                  <td>{item.version}</td>
                  <td>{item.type}</td>
                  <td>{item.description}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3 class="mt-10 font-mono text-xs font-semibold tracking-[0.14em] text-steel-500 uppercase dark:text-steel-400">
        {t('catalog.rulesHeading')}
      </h3>
      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          ruleItems.map((item) => (
            <div class="marketing-panel p-5">
              <h4 class="text-sm font-semibold text-steel-950 dark:text-steel-50">{item.name}</h4>
              <p class="mt-2 text-sm leading-6 text-steel-600 dark:text-steel-300">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('testing.heading')} description={t('testing.description')} />
      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          specimenItems.map((item) => (
            <div class="marketing-panel p-5">
              <code class="font-mono text-xs font-medium text-molten-600 dark:text-molten-400">{item.code}</code>
              <p class="mt-2 text-sm leading-6 text-steel-600 dark:text-steel-300">{item.description}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm leading-6 text-steel-500 dark:text-steel-400">
        {t('testing.footer')}
      </p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('monorepo.heading')} description={t('monorepo.description')} />
      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          monorepoTeams.map((team) => (
            <div class="marketing-panel p-5">
              <h4 class="font-mono text-sm font-semibold text-molten-600 dark:text-molten-400">{team.name}</h4>
              <p class="mt-2 text-sm leading-6 text-steel-600 dark:text-steel-300">{team.description}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm leading-6 text-steel-500 dark:text-steel-400">
        {t('monorepo.footer')}
      </p>
      <div class="mt-4">
        <a
          href="https://github.com/crucibledx/forge-skills-starter/tree/example/monorepo"
          class="text-sm font-semibold text-molten-600 transition-colors hover:text-molten-700 dark:text-molten-400 dark:hover:text-molten-300"
        >
          {t('monorepo.ctaLabel')}
        </a>
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('delivery.heading')} description={t('delivery.description')} />
      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
        <div class="marketing-panel border-molten-200 p-6 dark:border-molten-800">
          <h3 class="text-base font-semibold text-molten-600 dark:text-molten-400">{t('delivery.forge.title')}</h3>
          <p class="mt-3 text-sm leading-6 text-steel-600 dark:text-steel-300">{t('delivery.forge.description')}</p>
        </div>
        <div class="marketing-panel p-6">
          <h3 class="text-base font-semibold text-steel-950 dark:text-steel-50">{t('delivery.submodules.title')}</h3>
          <p class="mt-3 text-sm leading-6 text-steel-600 dark:text-steel-300">
            {t('delivery.submodules.description')}
          </p>
        </div>
        <div class="marketing-panel p-6">
          <h3 class="text-base font-semibold text-steel-950 dark:text-steel-50">{t('delivery.custom.title')}</h3>
          <p class="mt-3 text-sm leading-6 text-steel-600 dark:text-steel-300">{t('delivery.custom.description')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-16">
      <SectionHeading heading={t('withForge.heading')} description={t('withForge.description')} />
      <div class="code-panel">
        <div><span class="text-steel-400">$</span> forge init</div>
        <div class="text-steel-400"># → Select "git" source → paste your fork's URL</div>
        <div class="mt-2"><span class="text-steel-400">$</span> forge sync</div>
        <div class="text-steel-400"># → Skills placed for each supported coding harness</div>
      </div>
    </div>
  </section>
</MarketingLayout>
