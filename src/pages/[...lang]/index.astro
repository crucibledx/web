---
import MarketingLayout from '../../layouts/MarketingLayout.astro'
import Hero from '../../components/Hero.astro'
import ProductCard from '../../components/ProductCard.astro'
import SupportedTools from '../../components/SupportedTools.astro'
import FeatureGrid from '../../components/FeatureGrid.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import {getLocalePaths, useTranslations} from '../../i18n'
import {demos} from '../../lib/assets'
import type {LocaleProps} from '../../i18n'

export const getStaticPaths = getLocalePaths

const {locale} = Astro.props as LocaleProps
const t = useTranslations(locale, 'home')
---

<MarketingLayout title={t('meta.title')} description={t('meta.description')} locale={locale}>
  <Hero
    headline={t('hero.headline')}
    subheadline={t('hero.subheadline')}
    ctaPrimary={{label: t('hero.ctaPrimary'), href: '/getting-started/installation'}}
    ctaSecondary={{label: t('hero.ctaSecondary'), href: 'https://github.com/crucibledx'}}
    terminalDemo={{
      title: t('hero.terminalDemo'),
      darkSrc: demos.forge.setAndForget('dark'),
      lightSrc: demos.forge.setAndForget('light'),
      alt: 'Forge CLI — set and forget demo',
    }}
  />

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('problem.heading')} />
      <div class="mt-10">
        <FeatureGrid
          columns={3}
          features={[
            {
              icon: t('problem.scattered.icon'),
              title: t('problem.scattered.title'),
              description: t('problem.scattered.description'),
            },
            {
              icon: t('problem.drift.icon'),
              title: t('problem.drift.title'),
              description: t('problem.drift.description'),
            },
            {
              icon: t('problem.visibility.icon'),
              title: t('problem.visibility.title'),
              description: t('problem.visibility.description'),
            },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('howItWorks.heading')} />
      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-0">
        {
          [1, 2, 3].map((step) => (
            <div class="relative border-l border-steel-200 pl-6 md:pr-8 dark:border-steel-800">
              <div class="absolute top-0 -left-[5px] h-2.5 w-2.5 rounded-full bg-molten-500" />
              <span class="font-mono text-xs font-semibold tracking-[0.16em] text-molten-600 dark:text-molten-400">
                0{step}
              </span>
              <h3 class="mt-3 text-lg font-semibold tracking-tight text-steel-950 dark:text-steel-50">
                {t(`howItWorks.step${step}.title`)}
              </h3>
              <p class="mt-2 text-sm leading-6 text-steel-600 dark:text-steel-300">
                {t(`howItWorks.step${step}.description`)}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SupportedTools heading={t('tools.heading')} footer={t('tools.more')} />
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('ecosystem.heading')} />
      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
        <ProductCard
          name={t('ecosystem.forge.name')}
          description={t('ecosystem.forge.description')}
          href="/forge"
          iconName="cib:conda-forge"
          iconClass="text-molten-500"
          badge={t('ecosystem.forge.badge')}
        />
        <ProductCard
          name={t('ecosystem.starter.name')}
          description={t('ecosystem.starter.description')}
          href="/starter"
          iconName="carbon:platforms"
          iconClass="text-molten-500"
          badge={t('ecosystem.starter.badge')}
        />
        <ProductCard
          name={t('ecosystem.ember.name')}
          description={t('ecosystem.ember.description')}
          href="/ember"
          iconName="game-icons:ember-shot"
          iconClass="text-molten-500"
          badge={t('ecosystem.ember.badge')}
        />
      </div>
      <p class="mt-8 text-sm leading-6 text-steel-500 dark:text-steel-400">
        {t('ecosystem.more').split('{link}')[0]}<a
          href="/about"
          class="font-medium text-molten-600 hover:text-molten-700 dark:text-molten-400 dark:hover:text-molten-300"
          >{t('ecosystem.roadmapLink')}</a
        >{t('ecosystem.more').split('{link}')[1]}
      </p>
    </div>
  </section>
</MarketingLayout>
