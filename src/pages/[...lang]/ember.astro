---
import MarketingLayout from '../../layouts/MarketingLayout.astro'
import Hero from '../../components/Hero.astro'
import FeatureGrid from '../../components/FeatureGrid.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import {getLocalePaths, getMessages, useTranslations} from '../../i18n'
import type {LocaleProps} from '../../i18n'

export const getStaticPaths = getLocalePaths

const {locale} = Astro.props as LocaleProps
const t = useTranslations(locale, 'ember')
const messages = getMessages(locale, 'ember')

const loopSteps = messages.loop.steps as string[]
const landscapeItems = messages.landscape.items as Array<{
  tool: string
  does: string
  relationship: string
}>
---

<MarketingLayout title={t('meta.title')} description={t('meta.description')} locale={locale}>
  <Hero headline={t('hero.headline')} subheadline={t('hero.subheadline')} badge={t('hero.badge')} />

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('problem.heading')} />
      <div class="mt-10">
        <FeatureGrid
          columns={3}
          features={messages.problem.items as Array<{icon: string; title: string; description: string}>}
        />
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <div class="marketing-panel p-6 md:p-10">
        <SectionHeading heading={t('architecture.heading')} description={t('architecture.caption')} />
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-16">
      <SectionHeading heading={t('loop.heading')} description={t('loop.description')} />
      <div class="flex flex-col items-stretch gap-3 md:flex-row md:items-center md:justify-between">
        {
          loopSteps.map((step, i, arr) => (
            <>
              <span class="marketing-panel px-4 py-3 text-center font-mono text-xs font-semibold text-molten-600 dark:text-molten-400">
                {step}
              </span>
              {i < arr.length - 1 && <span class="text-center text-steel-400 dark:text-steel-600">→</span>}
            </>
          ))
        }
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('value.heading')} />
      <div class="mt-10">
        <FeatureGrid
          columns={3}
          features={messages.value.items as Array<{icon: string; title: string; description: string}>}
        />
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('otel.heading')} description={t('otel.description')} />
      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
        <div class="marketing-panel p-6">
          <h3 class="text-base font-semibold text-steel-950 dark:text-steel-50">{t('otel.claudeCode.title')}</h3>
          <p
            class="mt-3 text-sm leading-6 text-steel-600 dark:text-steel-300"
            set:html={t('otel.claudeCode.description')}
          />
        </div>
        <div class="marketing-panel border-molten-200 p-6 dark:border-molten-800">
          <h3 class="text-base font-semibold text-molten-600 dark:text-molten-400">{t('otel.ember.title')}</h3>
          <p class="mt-3 text-sm leading-6 text-steel-600 dark:text-steel-300" set:html={t('otel.ember.description')} />
        </div>
        <div class="marketing-panel p-6">
          <h3 class="text-base font-semibold text-steel-950 dark:text-steel-50">{t('otel.combined.title')}</h3>
          <p
            class="mt-3 text-sm leading-6 text-steel-600 dark:text-steel-300"
            set:html={t('otel.combined.description')}
          />
        </div>
      </div>
      <p class="mt-6 text-sm leading-6 text-steel-500 dark:text-steel-400">
        {t('otel.footer')}
      </p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <SectionHeading heading={t('dashboard.heading')} />
      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2">
        <div class="marketing-panel p-6">
          <h3
            class="mb-5 font-mono text-xs font-semibold tracking-[0.12em] text-steel-500 uppercase dark:text-steel-400"
          >
            {t('dashboard.skills.title')}
          </h3>
          <div class="space-y-4">
            <div>
              <div class="mb-1.5 flex justify-between text-xs">
                <span class="text-steel-600 dark:text-steel-300">Read</span><span
                  class="font-mono text-molten-600 dark:text-molten-400">847</span
                >
              </div>
              <div class="h-1.5 rounded-full bg-steel-100 dark:bg-steel-700">
                <div class="h-1.5 rounded-full bg-molten-500" style="width: 95%"></div>
              </div>
            </div>
            <div>
              <div class="mb-1.5 flex justify-between text-xs">
                <span class="text-steel-600 dark:text-steel-300">Edit</span><span
                  class="font-mono text-molten-600 dark:text-molten-400">623</span
                >
              </div>
              <div class="h-1.5 rounded-full bg-steel-100 dark:bg-steel-700">
                <div class="h-1.5 rounded-full bg-molten-400" style="width: 70%"></div>
              </div>
            </div>
            <div>
              <div class="mb-1.5 flex justify-between text-xs">
                <span class="text-steel-600 dark:text-steel-300">mcp__github__get_issue</span><span
                  class="font-mono text-molten-600 dark:text-molten-400">412</span
                >
              </div>
              <div class="h-1.5 rounded-full bg-steel-100 dark:bg-steel-700">
                <div class="h-1.5 rounded-full bg-molten-300" style="width: 46%"></div>
              </div>
            </div>
            <div>
              <div class="mb-1.5 flex justify-between text-xs">
                <span class="text-steel-600 dark:text-steel-300">SpawnAgent</span><span
                  class="font-mono text-molten-600 dark:text-molten-400">89</span
                >
              </div>
              <div class="h-1.5 rounded-full bg-steel-100 dark:bg-steel-700">
                <div class="h-1.5 rounded-full bg-molten-200" style="width: 10%"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="marketing-panel p-6">
          <h3
            class="mb-5 font-mono text-xs font-semibold tracking-[0.12em] text-steel-500 uppercase dark:text-steel-400"
          >
            {t('dashboard.tokens.title')}
          </h3>
          <div class="space-y-5">
            <div class="flex items-center justify-between gap-4">
              <span class="text-sm font-medium text-steel-600 dark:text-steel-300">Claude Sonnet</span>
              <div class="text-right">
                <span class="text-xl font-semibold tracking-tight text-steel-950 dark:text-steel-50">2.4M</span>
                <span class="ml-1 text-xs text-steel-500 dark:text-steel-400">tokens</span>
              </div>
            </div>
            <div class="flex items-center justify-between gap-4">
              <span class="text-sm font-medium text-steel-600 dark:text-steel-300">Claude Haiku</span>
              <div class="text-right">
                <span class="text-xl font-semibold tracking-tight text-steel-950 dark:text-steel-50">1.8M</span>
                <span class="ml-1 text-xs text-steel-500 dark:text-steel-400">tokens</span>
              </div>
            </div>
            <div class="flex items-center justify-between gap-4">
              <span class="text-sm font-medium text-steel-600 dark:text-steel-300">Unspecified model</span>
              <div class="text-right">
                <span class="text-xl font-semibold tracking-tight text-steel-950 dark:text-steel-50">960K</span>
                <span class="ml-1 text-xs text-steel-500 dark:text-steel-400">tokens</span>
              </div>
            </div>
          </div>
          <div
            class="mt-5 rounded-lg bg-steel-50 px-3 py-2 text-xs leading-5 text-steel-500 dark:bg-steel-950 dark:text-steel-400"
          >
            Native cost metrics retain the harness's reported currency.
          </div>
        </div>

        <div class="marketing-panel p-6">
          <h3
            class="mb-5 font-mono text-xs font-semibold tracking-[0.12em] text-steel-500 uppercase dark:text-steel-400"
          >
            {t('dashboard.distribution.title')}
          </h3>
          <div class="flex h-48 items-end gap-5">
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-14 rounded-t-md bg-molten-500" style="height: 120px"></div>
              <span class="text-xs text-steel-500 dark:text-steel-400">Droid</span>
              <span class="font-mono text-xs font-medium text-steel-600 dark:text-steel-300">62%</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-14 rounded-t-md bg-molten-300" style="height: 74px"></div>
              <span class="text-xs text-steel-500 dark:text-steel-400">Claude Code</span>
              <span class="font-mono text-xs font-medium text-steel-600 dark:text-steel-300">38%</span>
            </div>
          </div>
        </div>

        <div class="marketing-panel p-6">
          <h3
            class="mb-5 font-mono text-xs font-semibold tracking-[0.12em] text-steel-500 uppercase dark:text-steel-400"
          >
            {t('dashboard.versions.title')}
          </h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-3 rounded-lg bg-steel-50 px-3 py-2.5 dark:bg-steel-950">
              <div>
                <span class="text-sm font-medium text-steel-600 dark:text-steel-300">crucibledx/web#6</span>
                <span
                  class="ml-2 rounded bg-green-100 px-1.5 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400"
                  >Droid</span
                >
              </div>
              <span class="font-mono text-xs whitespace-nowrap text-steel-500 dark:text-steel-400">42 spans</span>
            </div>
            <div class="flex items-center justify-between gap-3 rounded-lg bg-steel-50 px-3 py-2.5 dark:bg-steel-950">
              <div>
                <span class="text-sm font-medium text-steel-600 dark:text-steel-300">crucibledx/web#6</span>
                <span
                  class="ml-2 rounded bg-yellow-100 px-1.5 py-0.5 text-xs font-medium text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400"
                  >Claude Code</span
                >
              </div>
              <span class="font-mono text-xs whitespace-nowrap text-steel-500 dark:text-steel-400">17 spans</span>
            </div>
            <div class="flex items-center justify-between gap-3 rounded-lg bg-steel-50 px-3 py-2.5 dark:bg-steel-950">
              <div>
                <span class="text-sm font-medium text-steel-600 dark:text-steel-300">crucibledx/ember#13</span>
                <span
                  class="ml-2 rounded bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-700 dark:bg-red-900/30 dark:text-red-400"
                  >Droid</span
                >
              </div>
              <span class="font-mono text-xs whitespace-nowrap text-steel-500 dark:text-steel-400">31 spans</span>
            </div>
          </div>
        </div>
      </div>
      <p class="mt-6 text-xs leading-5 text-steel-500 dark:text-steel-400">
        {t('dashboard.caption')}
      </p>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('landscape.heading')} />
      <div class="marketing-table-wrap" tabindex="0" role="region" aria-label={t('landscape.heading')}>
        <table class="marketing-table">
          <thead>
            <tr>
              <th>{t('landscape.thTool')}</th>
              <th>{t('landscape.thDoes')}</th>
              <th>{t('landscape.thRelationship')}</th>
            </tr>
          </thead>
          <tbody>
            {
              landscapeItems.map((item, i) => (
                <tr>
                  <td class="font-semibold text-steel-950 dark:text-steel-50">{item.tool}</td>
                  <td>{item.does}</td>
                  <td class={i === 0 ? 'text-molten-600 dark:text-molten-400' : ''}>{item.relationship}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm font-medium text-molten-600 dark:text-molten-400">
        {t('landscape.footer')}
      </p>
    </div>
  </section>
</MarketingLayout>
