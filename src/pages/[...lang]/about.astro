---
import MarketingLayout from '../../layouts/MarketingLayout.astro'
import Hero from '../../components/Hero.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import {getLocalePaths, getMessages, useTranslations} from '../../i18n'
import type {LocaleProps} from '../../i18n'

export const getStaticPaths = getLocalePaths

const {locale} = Astro.props as LocaleProps
const t = useTranslations(locale, 'about')
const messages = getMessages(locale, 'about')

const metaphorItems = messages.metaphor.items as Array<{name: string; description: string}>
const principleItems = messages.principles.items as Array<{title: string; description: string}>
const roadmapItems = messages.roadmap.items as Array<{
  name: string
  type: string
  purpose: string
  status: string
}>

const statusClasses: Record<string, string> = {
  Shipped: 'border-green-200 bg-green-50 text-green-700 dark:border-green-900 dark:bg-green-950/40 dark:text-green-400',
  'In development':
    'border-molten-200 bg-molten-50 text-molten-700 dark:border-molten-900 dark:bg-molten-950/40 dark:text-molten-400',
  Designed: 'border-steel-200 bg-steel-50 text-steel-600 dark:border-steel-700 dark:bg-steel-950 dark:text-steel-300',
}
---

<MarketingLayout title={t('meta.title')} description={t('meta.description')} locale={locale}>
  <Hero headline={t('hero.headline')} subheadline={t('hero.subheadline')} />

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('metaphor.heading')} description={t('metaphor.description')} />
      <div
        class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-steel-200 bg-steel-200 md:grid-cols-2 dark:border-steel-800 dark:bg-steel-800"
      >
        {
          metaphorItems.map((item) => (
            <div class="bg-white p-5 md:p-6 dark:bg-steel-900">
              <span class="text-lg font-semibold tracking-tight text-molten-600 dark:text-molten-400">{item.name}</span>
              <span class="ml-2 text-sm leading-6 text-steel-600 dark:text-steel-300">{item.description}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <SectionHeading heading={t('principles.heading')} />
      <div class="space-y-8">
        {
          principleItems.map((item, i) => (
            <div class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-steel-200 pb-8 last:border-0 last:pb-0 dark:border-steel-800">
              <span class="font-mono text-sm font-semibold text-molten-600 dark:text-molten-400">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-lg font-semibold tracking-tight text-steel-950 dark:text-steel-50">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-steel-600 dark:text-steel-300">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section-muted">
    <div class="marketing-container">
      <SectionHeading heading={t('roadmap.heading')} />
      <div class="marketing-table-wrap" tabindex="0" role="region" aria-label={t('roadmap.heading')}>
        <table class="marketing-table">
          <thead>
            <tr>
              <th>{t('roadmap.thProduct')}</th>
              <th>{t('roadmap.thType')}</th>
              <th>{t('roadmap.thPurpose')}</th>
              <th>{t('roadmap.thStatus')}</th>
            </tr>
          </thead>
          <tbody>
            {
              roadmapItems.map((item) => (
                <tr>
                  <td class="font-semibold text-steel-950 dark:text-steel-50">{item.name}</td>
                  <td>{item.type}</td>
                  <td>{item.purpose}</td>
                  <td>
                    <span
                      class={`inline-flex rounded-full border px-2.5 py-1 text-xs font-medium whitespace-nowrap ${statusClasses[item.status] || statusClasses.Designed}`}
                    >
                      {item.status}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm leading-6 text-steel-500 dark:text-steel-400">
        <span set:html={t('roadmap.footer').split('{link}')[0]} /><a
          href="/platform/architecture"
          class="font-medium text-molten-600 hover:text-molten-700 dark:text-molten-400"
          >{t('roadmap.architectureLink')}</a
        ><span set:html={t('roadmap.footer').split('{link}')[1]} />
      </p>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-container">
      <div class="marketing-panel p-6 md:p-10">
        <SectionHeading heading={t('architecture.heading')} description={t('architecture.description')} />
        <p
          class="mt-6 border-t border-steel-200 pt-5 font-mono text-xs leading-6 text-steel-500 dark:border-steel-800 dark:text-steel-400"
        >
          {t('architecture.caption')}
        </p>
      </div>
    </div>
  </section>
</MarketingLayout>
